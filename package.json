{
  "name": "cabinet_costing",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "rebuild": "node scripts/rebuild.js",
    "pack:win": "node scripts/pack-win.js",
    "build:win": "electron-builder --win --x64",
    "start": "electron index.js --no-sandbox",
    "start:linux": "env -u WAYLAND_DISPLAY -u XDG_SESSION_TYPE GDK_BACKEND=x11 ELECTRON_DISABLE_SANDBOX=1 ./node_modules/.bin/electron index.js --no-sandbox > electron_output.log 2>&1",
    "seed:db": "env ELECTRON_DISABLE_SANDBOX=1 ./node_modules/.bin/electron --no-sandbox scripts/seed-db.js",
    "db:backup": "electron --no-sandbox scripts/db-backup.js",
    "db:restore": "electron --no-sandbox scripts/db-restore.js"
  },
  "author": "Faizan Ali",
  "license": "ISC",
  "engines": {
    "node": "24.x",
    "npm": "10.x"
  },
  "packageManager": "npm@10.x",
  "devDependencies": {
    "@electron/packager": "^19.0.0",
    "@electron/rebuild": "^4.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.cabinetcosting.app",
    "productName": "CabinetCosting",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "seed/cabinet_costing.db.bak",
        "to": "seed/cabinet_costing.db.bak"
      }
    ],
    "files": [
      "**/*",
      "!src/db/.*.json",
      "!src/db/.*.json.bak",
      "!src/db/*.json.bak"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "asar": true
  },
  "dependencies": {
    "@fortawesome/fontawesome": "^1.1.8",
    "@fortawesome/fontawesome-free-solid": "^5.0.13",
    "better-sqlite3": "^12.0.0",
    "bootstrap": "^4.3.1",
    "bootstrap-input-spinner": "^1.11.4",
    "html2pdf.js": "^0.10.1",
    "jquery": "^3.4.1",
    "jspdf": "^2.5.1",
    "moment": "^2.29.4",
    "popper.js": "^1.15.0",
    "tablesort": "5.1.0",
    "xlsx": "0.16.9"
  }
}
